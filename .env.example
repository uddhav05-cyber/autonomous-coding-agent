# Environment variables for Autonomous Coding Agent
# Copy this file to .env and fill in the values

# Application settings
AUTONOMOUS_AGENT_ENVIRONMENT=development
AUTONOMOUS_AGENT_LOG_LEVEL=INFO
AUTONOMOUS_AGENT_WORKSPACE_PATH=./workspace

# Model provider settings
AUTONOMOUS_AGENT_MODEL_PROVIDER_PROVIDER=anthropic
AUTONOMOUS_AGENT_MODEL_PROVIDER_MODEL_NAME=claude-3-opus-20240229
AUTONOMOUS_AGENT_MODEL_PROVIDER_API_KEY=your_api_key_here
AUTONOMOUS_AGENT_MODEL_PROVIDER_BASE_URL=
AUTONOMOUS_AGENT_MODEL_PROVIDER_MAX_TOKENS=4096
AUTONOMOUS_AGENT_MODEL_PROVIDER_TEMPERATURE=0.0

# Execution limits
AUTONOMOUS_AGENT_EXECUTION_LIMITS_MAX_ITERATIONS=10
AUTONOMOUS_AGENT_EXECUTION_LIMITS_MAX_TOOL_CALLS=50
AUTONOMOUS_AGENT_EXECUTION_LIMITS_MAX_CONTEXT_TOKENS=8000
AUTONOMOUS_AGENT_EXECUTION_LIMITS_TIMEOUT_SECONDS=300

# Timeout settings
AUTONOMOUS_AGENT_TIMEOUTS_TOOL_EXECUTION=30
AUTONOMOUS_AGENT_TIMEOUTS_MODEL_RESPONSE=60
AUTONOMOUS_AGENT_TIMEOUTS_VERIFICATION=120